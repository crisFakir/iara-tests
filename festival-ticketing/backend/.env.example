# Database - PostgreSQL com replicação
DATABASE_URL="postgresql://user:password@localhost:5432/festival_tickets"
DATABASE_REPLICA_URL="postgresql://user:password@localhost:5433/festival_tickets"
REDIS_URL="redis://localhost:6379"
REDIS_CLUSTER_NODES="redis://localhost:6379,redis://localhost:6380,redis://localhost:6381"

# API Configuration
NODE_ENV=production
PORT=3000
API_VERSION=v1
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-change-this
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_ROUNDS=12

# MB Way Configuration
MBWAY_API_URL=https://api.ifthenpay.com/mbway
MBWAY_API_KEY=your-mbway-api-key
MBWAY_ENTITY=your-entity-code
MBWAY_SUBENTITY=your-subentity-code
MBWAY_WEBHOOK_SECRET=your-webhook-secret
MBWAY_TIMEOUT_MINUTES=5
MBWAY_MAX_RETRIES=3

# Email Service (SendGrid/AWS SES)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@festivaltickets.pt
EMAIL_FROM_NAME=Festival Tickets

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+351900000000

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=festival-tickets-assets

# Monitoring & Logging
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key
LOG_LEVEL=info
ENABLE_PERFORMANCE_MONITORING=true

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_ENABLE_CLUSTER=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=30

# App Configuration
APP_URL=https://app.festivaltickets.pt
ADMIN_URL=https://admin.festivaltickets.pt
API_URL=https://api.festivaltickets.pt

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PAYMENT_RETRY=true
ENABLE_AUTO_RECOVERY=true